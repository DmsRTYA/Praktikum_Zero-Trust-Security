# Salin menjadi .env, atau jalankan "npm run setup" agar nilai acak dibuat otomatis.
# Semua secret HARUS berbeda satu sama lain dan tidak boleh di-commit.

DB_PATH=./db/nilai.db
JWT_ISSUER=zt-gateway
# Private key HANYA dibaca gateway. Service hanya membaca public key.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Secret gateway -> service (hex 32 byte acak)
GATEWAY_SECRET=GANTI_DENGAN_HEX_ACAK
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002
GATEWAY_URL=http://127.0.0.1:3000

ACCESS_TOKEN_TTL=10m
SERVICE_TOKEN_TTL=5m
REFRESH_TOKEN_TTL_HOURS=24

# Jam akses untuk PUT nilai dan finalisasi (format HH:MM, selesai eksklusif)
JAM_AKSES_MULAI=07:00
JAM_AKSES_SELESAI=21:00
JAM_AKSES_TZ=Asia/Jakarta

# Kredensial Service Nilai ke gateway (POST /auth/service)
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=GANTI_DENGAN_HEX_ACAK

# Hanya dipakai oleh "npm run seed"
SEED_DEFAULT_PASSWORD=GANTI_PASSWORD_DEMO

# true = panel akun demo di halaman login + simulator jam akses. Matikan di luar demo.
DEMO_MODE=false
